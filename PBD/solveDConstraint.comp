#version 430

layout(local_size_x = 256) in;

// particleSSBO (binding=0): 파티클당 vec4 3개 [pos|mass], [vel|isFixed], [newP|0]
layout(std430, binding = 0) buffer Particles {
    vec4 pData[];
};

// DConstraintSSBO (binding=1): constraint당 vec4 1개 [idx1, idx2, restLength, 0]
layout(std430, binding = 1) buffer DConstraints {
    vec4 cData[];
};

uniform int startIdx;  // 이번 색 그룹의 SSBO 시작 인덱스
uniform int count;     // 이번 색 그룹의 constraint 수

void main() {
    int tid = int(gl_GlobalInvocationID.x);
    if (tid >= count) return;

    vec4  cInfo   = cData[startIdx + tid];
    int   idx1    = int(cInfo.x);
    int   idx2    = int(cInfo.y);
    float restLen = cInfo.z;

    int base1 = idx1 * 3;
    int base2 = idx2 * 3;

    float mass1    = pData[base1].w;
    float isFixed1 = pData[base1 + 1].w;
    vec3  newP1    = pData[base1 + 2].xyz;

    float mass2    = pData[base2].w;
    float isFixed2 = pData[base2 + 1].w;
    vec3  newP2    = pData[base2 + 2].xyz;

    vec3  diff = newP1 - newP2;
    float dist = length(diff);
    if (dist < 1e-8) return;

    float w1   = isFixed1 == 1.0 ? 0.0 : 1.0 / mass1;
    float w2   = isFixed2 == 1.0 ? 0.0 : 1.0 / mass2;
    float wsum = w1 + w2;
    if (wsum < 1e-8) return;

    vec3 corr = ((dist - restLen) / wsum) * (diff / dist);

    if (isFixed1 == 0.0) pData[base1 + 2] = vec4(newP1 - w1 * corr, 0.0);
    if (isFixed2 == 0.0) pData[base2 + 2] = vec4(newP2 + w2 * corr, 0.0);
}
